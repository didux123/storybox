# StoryBox IA - Environment Configuration
# Copy this file to .env and update with your settings

# =============================================================================
# CLOUD API MODE (main branch - recommended)
# =============================================================================
# API Keys for Celeste (cloud-based AI services)
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google Gemini: https://makersuite.google.com/app/apikey
# - Mistral: https://console.mistral.ai/

# Gemini (RECOMMENDED for Raspberry Pi - fast and free tier available)
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL_PATH=gemini-2.0-flash-exp

# Alternatives (uncomment to use)
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL_PATH=gpt-4o-mini

# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_MODEL_PATH=claude-3-5-sonnet-20241022

# MISTRAL_API_KEY=your-mistral-api-key-here
# LLM_MODEL_PATH=mistral-large-2411

# =============================================================================
# LOCAL MODEL MODE (local_storybox branch - offline)
# =============================================================================
# Uncomment these if using local models (see local_storybox branch)
# Download models from:
# - Whisper: https://huggingface.co/ggerganov/whisper.cpp
# - Llama: https://huggingface.co/TheBloke
# - Piper: https://github.com/rhasspy/piper/releases

# WHISPER_MODEL_PATH=/Users/maxence/models/whisper/ggml-small.bin
# LLM_MODEL_PATH=/Users/maxence/models/llm/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# PIPER_MODEL_PATH=/Users/maxence/models/piper/fr_FR-siwis-medium.onnx
# PIPER_CONFIG_PATH=/Users/maxence/models/piper/fr_FR-siwis-medium.onnx.json

# Audio devices (optional, defaults to system default)
# AUDIO_INPUT_DEVICE=default
# AUDIO_OUTPUT_DEVICE=default

# GPIO pins (Raspberry Pi only)
# BUTTON_PIN=17
# LED_PIN_IDLE=22
# LED_PIN_ACTIVE=23
# LED_PIN_ERROR=24

# Logging
# LOG_LEVEL=INFO
# LOG_DIR=logs
