# StoryBox IA - Environment Variables Example
# Copy this file to .env and fill in your values

# Raspberry Pi SSH Configuration
RPI_IP_ADDRESS=192.168.1.100
RPI_SSH_PASSWORD=your_password_here
SSH_KEY_PASSPHRASE=your_key_passphrase_if_applicable

# Model Paths (override YAML config if needed)
# WHISPER_MODEL_PATH=/home/maxence/models/whisper/ggml-small.bin
# LLM_MODEL_PATH=/home/maxence/models/llm/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# PIPER_MODEL_PATH=/home/maxence/models/piper/fr_FR-siwis-medium.onnx

# Audio Device Configuration (ALSA)
# AUDIO_INPUT_DEVICE=default
# AUDIO_OUTPUT_DEVICE=default

# Logging
LOG_LEVEL=INFO

# Development
# MOCK_GPIO=true  # Set to true for Mac development
